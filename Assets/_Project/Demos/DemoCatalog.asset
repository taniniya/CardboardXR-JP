%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3153debd146ee47ea8f7e9f6ae859def, type: 3}
  m_Name: DemoCatalog
  m_EditorClassIdentifier: CardboardXR.Demos::CardboardXR.Demos.DemoCatalog
  m_LobbyScenePath: Assets/_Project/Demos/Lobby/Lobby.unity
  m_Demos:
  - Id: sandbox
    Title: キューブ箱庭
    Description: カメラ越しの自分の部屋。テーブルや床を見てタップかピンチすると、そこにキューブを置けます。置いたキューブは手でつかんで動かせます。
    Tagline: 自分の机や床にキューブを置いて動かす
    Icon: view_in_ar
    Tint: {r: 0.78, g: 0.49, b: 0.12, a: 1}
    ScenePath: Assets/_Project/Demos/Sandbox/Sandbox.unity
    Requirements:
      SixDof: 2
      Passthrough: 2
      Hands: 2
      ScanSurfaces: 1
      KeepPlacedObjects: 0
      HideCorePanel: 0
  - Id: video
    Title: 360度動画
    Description: 360度動画とVR180動画を、2Dでも3Dでも周囲に映して見られます。動画をタップすると操作パネルが出ます。スマホにコピーした動画や、Google Driveで共有した動画を再生できます。
    Tagline: 360度・VR180の動画を周囲に映す
    Icon: 360
    Tint: {r: 0.7, g: 0.25, b: 0.29, a: 1}
    ScenePath: Assets/_Project/Demos/Video/Video.unity
    Requirements:
      SixDof: 1
      Passthrough: 1
      Hands: 1
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HideCorePanel: 1
  - Id: paint
    Title: 空間ペイント
    Description: Tilt Brushのように、手で空中に絵を描けます。ピンチで描画。ツールパネルを見てピンチすると、色・筆・太さを変えられます。
    Tagline: 手で空中に絵を描く
    Icon: brush
    Tint: {r: 0.48, g: 0.31, b: 0.75, a: 1}
    ScenePath: Assets/_Project/Demos/Paint/Paint.unity
    Requirements:
      SixDof: 2
      Passthrough: 2
      Hands: 2
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HideCorePanel: 1
  - Id: rush
    Title: オーブラッシュ
    Description: オーブが手前に飛んできます。リングに届くところで手で打ちましょう。片手で1分1ラウンド、だんだん速くなります。
    Tagline: 飛んでくるオーブを手で打つ
    Icon: bolt
    Tint: {r: 0.12, g: 0.55, b: 0.62, a: 1}
    ScenePath: Assets/_Project/Demos/Rush/Rush.unity
    Requirements:
      SixDof: 2
      Passthrough: 1
      Hands: 2
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HideCorePanel: 1
  - Id: portal
    Title: ポータル
    Description: 床にドアを開けて、別の世界へ歩いて入れます。振り返れば、ドアの向こうに自分の部屋が見えます。
    Tagline: 床に開いたドアから別世界へ
    Icon: door_front
    Tint: {r: 0.23, g: 0.25, b: 0.6, a: 1}
    ScenePath: Assets/_Project/Demos/Portal/Portal.unity
    Requirements:
      SixDof: 2
      Passthrough: 2
      Hands: 2
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HideCorePanel: 1
